ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
# Comma-separated frontend origins, no trailing slashes needed.
# Example: https://debateai.dev,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_API_KEY=

# Set to "production" on Railway to disable /docs and hide OpenAPI schema
ENVIRONMENT=development

# Optional overrides (defaults shown)
# SONNET_MONTHLY_LIMIT=30
# GENERATE_DAILY_LIMIT=50
# FEEDBACK_DAILY_LIMIT=20
# TRAINING_DAILY_LIMIT=5
# PREMIUM_MODEL=claude-sonnet-5
# STANDARD_MODEL=claude-haiku-4-5
# TITLE_MODEL=claude-haiku-4-5
# MAX_PROMPT_CHARS=8000
# MAX_TRAINING_FILE_BYTES=512000

# Set daily spend caps in Anthropic and OpenAI dashboards (not configurable here)
